---
import { ANIMATED_UNDERLINE_CLASSES } from '@/lib/animatedUnderline';

interface Props {
  name: string;
  description: string;
  technologies: string[];
  url: string;
}

const { name, description, technologies, url } = Astro.props;
---

<article class="flex flex-col border-2 border-ink bg-bg-elevated p-6 shadow-[6px_6px_0_0_var(--ink)]">
  <h2 class="m-0 text-[1.5em] leading-[1.2] font-bold tracking-[0.005em] text-ink">{name}</h2>
  <p class="mt-3 leading-[1.55] text-ink-soft">{description}</p>
  {technologies.length > 0 && (
    <ul class="m-0 mt-4 flex list-none flex-wrap gap-2 p-0" aria-label={`${name} technologies`}>
      {technologies.map((technology) => (
        <li class="border-2 border-ink bg-bg px-[0.6rem] py-[0.14rem] font-mono text-[0.7rem] leading-[1.4] font-bold text-ink">
          {technology}
        </li>
      ))}
    </ul>
  )}
  <p class:list={['mt-auto pt-5 font-heading font-bold text-accent', ...ANIMATED_UNDERLINE_CLASSES]}>
    <a href={url} target="_blank" rel="noopener" aria-label={`View ${name} on GitHub`}>
      View on GitHub
    </a>
  </p>
</article>
