---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'figure'> {
  src: ImageMetadata;
  alt: string;
  /** Text on the chin of the photo. */
  caption?: string;
  /** Intrinsic width (px) of the optimized image. */
  width?: number;
  loading?: 'eager' | 'lazy';
}

const { src, alt, caption, width = 768, loading = 'lazy', class: className, ...rest } = Astro.props;

const frameClasses = [
  'relative',
  'm-0',
  'rotate-2',
  'border-2',
  'border-ink',
  'bg-bg-elevated',
  'px-4',
  'pt-4',
  'pb-9',
  'shadow-[6px_6px_0_0_var(--ink)]',
];
---

<figure class:list={[frameClasses, className]} {...rest}>
  <span
    class="absolute -top-3 left-1/2 h-6 w-20 -translate-x-1/2 border-2 border-ink bg-accent"
    aria-hidden="true"
  ></span>
  <Image {src} {alt} {width} {loading} class="aspect-[3/4] w-full border-2 border-ink object-cover" />
  {caption && (
    <figcaption class="mt-6 text-center font-heading text-[1.25rem] leading-none font-bold text-ink">
      {caption}
    </figcaption>
  )}
</figure>
