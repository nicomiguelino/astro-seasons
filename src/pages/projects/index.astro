---
import { PROJECTS_DESCRIPTION, SITE_NAME } from '@/lib/site';
import Layout from '@/components/Layout.astro';
import Lede from '@/components/Lede.astro';
import PageHero from '@/components/PageHero.astro';
import ProjectCard from '@/components/ProjectCard.astro';

const projects = [
  {
    name: 'Example Project',
    description: 'A short description of what this project does and the problem it solves. Replace it with your own.',
    technologies: ['TypeScript', 'Astro', 'Tailwind CSS'],
    url: 'https://github.com/your-username/example-project',
  },
  {
    name: 'Another Project',
    description: 'A command-line tool that automates a repetitive task. Say what it is and who it is for.',
    technologies: ['Node.js', 'CLI'],
    url: 'https://github.com/your-username/another-project',
  },
  {
    name: 'Side Project',
    description: 'A small experiment built to learn something new. Mention what you picked up along the way.',
    technologies: ['Python', 'SQLite'],
    url: 'https://github.com/your-username/side-project',
  },
];
---

<Layout title=`Projects — ${SITE_NAME}` description={PROJECTS_DESCRIPTION} canonicalPath="/projects/">
  <main class="content-shell">
    <PageHero title="Projects" hideTitle>
      <Lede>{PROJECTS_DESCRIPTION}</Lede>
    </PageHero>

    <section class="section grid gap-8 md:grid-cols-2" aria-label="Projects">
      {projects.map((project) => (
        <ProjectCard {...project} />
      ))}
    </section>
  </main>
</Layout>
